# Email delivery for the contact form.
# Get a key at https://resend.com/api-keys (free tier is plenty for low-volume).
# If unset, the contact form falls back to a mailto: link so it still works.
RESEND_API_KEY=

# Provide a fallback destination for the contact form
CONTACT_TO_EMAIL="support@hakimerad.com"

# NextAuth.js configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-string-replace-in-production"

# Database Configuration (Local Docker MySQL)
MYSQL_HOST="localhost"
MYSQL_USER="hakimerad_user"
MYSQL_PASSWORD="hakimerad_pass"
MYSQL_DATABASE="hakimerad_db"

# Database Configuration (Production Plesk MySQL)
# MYSQL_HOST="localhost"
# MYSQL_USER="production_user"
# MYSQL_PASSWORD="production_password"
# MYSQL_DATABASE="production_db"

# "From" address Resend will use. Must be a verified domain in Resend.
# In production set this to something like: HakimeRAD <no-reply@hakimerad.health.et>
RESEND_FROM_EMAIL=HakimeRAD <onboarding@resend.dev>

# Canonical site URL (used for OG tags, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.hakimerad.health.et
